{
  "name": "home-server-openapi",
  "private": true,
  "scripts": {
    "bundle": "redocly bundle openapi.yaml --output dist/openapi.yaml --component-renaming-conflicts-severity=error",
    "generate:typescript": "openapi-typescript dist/openapi.yaml --output ../apps/web/src/api/generated/schema.d.ts --root-types --root-types-no-schema-prefix"
  },
  "devDependencies": {
    "@redocly/cli": "2.71.2",
    "openapi-typescript": "7.13.0"
  }
}
